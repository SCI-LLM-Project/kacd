{
  "json_schema": {
    "name": "KnowledgeGraph",
    "schema": {
      "$defs": {
        "SimpleNode": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "description": "Comprehensive description of the entity's attributes and activities",
              "minLength": 1,
              "title": "Description",
              "type": "string"
            },
            "id": {
              "description": "Name of the entity, capitalized",
              "minLength": 1,
              "title": "Id",
              "type": "string"
            },
            "type": {
              "description": "Type of the entity, capitalized",
              "minLength": 1,
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "id",
            "type",
            "description"
          ],
          "title": "SimpleNode",
          "type": "object"
        },
        "SimpleRelationship": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "description": "explanation as to why you think the source entity and the target entity are related to each other",
              "minLength": 1,
              "title": "Description",
              "type": "string"
            },
            "source_node_id": {
              "description": "name of the source entity",
              "minLength": 1,
              "title": "Source Node Id",
              "type": "string"
            },
            "source_node_type": {
              "description": "type of the source entity",
              "minLength": 1,
              "title": "Source Node Type",
              "type": "string"
            },
            "strength": {
              "description": "a numeric score indicating strength of the relationship between the source entity and target entity",
              "title": "Strength",
              "type": "integer"
            },
            "target_node_id": {
              "description": "name of the target entity",
              "minLength": 1,
              "title": "Target Node Id",
              "type": "string"
            },
            "target_node_type": {
              "description": "type of the target entity",
              "minLength": 1,
              "title": "Target Node Type",
              "type": "string"
            },
            "type": {
              "description": "name of the relationship",
              "minLength": 1,
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "source_node_id",
            "source_node_type",
            "target_node_id",
            "target_node_type",
            "type",
            "strength",
            "description"
          ],
          "title": "SimpleRelationship",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SimpleNode"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "List of nodes",
          "title": "Nodes"
        },
        "relationships": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SimpleRelationship"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "List of relationships",
          "title": "Relationships"
        }
      },
      "required": [
        "nodes",
        "relationships"
      ],
      "title": "KnowledgeGraph",
      "type": "object"
    }
  },
  "type": "json_schema"
}
